{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["cli.ts", "install.ts", "app/**/*.ts", "targets/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["targets/**/mods/**"]
}
